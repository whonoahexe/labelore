node_modules/
dist/
*.log
# Fixture outputs (spike out/ files) are committed on purpose: they are listed-by-name test inputs.
!test/fixtures/**/*.log

# Playwright UI/UX consistency sweep (quick-260921-l4e) — screenshots and results are
# regenerated by `npm run test:e2e`, never committed.
test/e2e/screenshots/
test-results/
playwright-report/

# Per-run GSD scratch — the dispatch-isolation sentinel workflows rewrite on
# every agent dispatch. Runtime state, not project content.
.gsd/
.playwright-mcp/

# Private, local-only paths: kept on disk, never tracked (quick-261116-qsy).
# Root-anchored so the nested fixture planning folders stay tracked.
/.planning/
/.claude/
/.mcp.json

# Private deny list read by test/fixture-leak.test.ts: local only, never tracked (quick-261116-r41).
/.leak-names.local.json

# Release build output: the staged capability tree and the packed tarball (phase 14). Root-anchored, never tracked.
/release/
/out/
*.tgz
